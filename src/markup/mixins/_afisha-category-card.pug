mixin afisha-category-card(title, link, colorClass, isTall)
    a(href=link class=`afisha__category-card ${colorClass || ''} ${isTall ? 'afisha__category-card--tall' : ''}`)
        .afisha__category-card-content
            h5.afisha__category-card-title= title
            .afisha__category-card-link
                span Посмотреть
                span.arrow →
