mixin vacancies-card(options = {})
	- const activeLike = options.activeLike || false
	article.vacancies__card
		.vacancies__card-inner
			.vacancies__card-content
				h4.title Водитель частной компании категории B
				span.price 108 000 – 150 000 ₽ за месяц, на руки
				.footer 
					a(href="#").button Откликнуться
					button.like(class=activeLike ? 'is-active' : '')
						+icon('icon-favorites')(width="24" height="24") 
			.vacancies__card-company
				.flex
					span.badge Без опыта
					span.badge Полный график
					span.badge Выплаты: два раза в месяц
				a(href="#").link
					h5.title Промышленный парк "РАЗВИТИЕ"
						+icon('icon-verify')(width="20" height="20") 
					span.text-gray.text-14 Все вакансии компании →
