mixin company-vacancy()
	article.company__vacancy
		.company__vacancy-content
			h4.title Водитель частной компании категории B
			span.price 108 000 – 150 000 ₽ за месяц, на руки
			.flex(style="margin-top:8px")
				span.badge Без опыта
				span.badge Полный график
				span.badge Выплаты: два раза в месяц
			.footer 
				a(href="#").button Откликнуться