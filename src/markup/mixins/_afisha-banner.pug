mixin afisha-banner(title, descr)
    .afisha__banner
        .afisha__banner-inner
            img(src='https://placehold.co/600x400', alt='').afisha__banner-img
            .afisha__banner-content
                div.text-12.badge-block
                    span.text-green Концерт
                    span ·
                    span 16+
                h5.title= title
                p.descr= descr
                div.text-12.badge-block
                    span 26 марта 
                    span ·
                    span 19:00
                    span .
                    span  Ледовый дворец спорта
                .afisha__banner-footer
                    a(href="#").button.button--dark.button--small= 'от 1200 ₽'
                    a(href='#').button.button--white Выбрать билеты
