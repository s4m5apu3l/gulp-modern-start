mixin news-card()
	article.news__card
		.news__card-inner
			.news__card-content
				.title
					span.news__card-badge Политика 
					h5.news__card-title Челнинцев приглашают стать участниками премии «Манзара»
					p.news__card-descr В это воскресенье в Казани состоится спортивная и музыкальная премия «Манзара», где будут организованы командные схватки «стенка на стенку» между командами Казани «Зилант» и Набережных Челнов.
				.footer.text-gray
					span.text-12 Сегодня,  09:19
					.view.text-12
						+icon('icon-eye-count')(width="16" height="16")
						span 245
			img(src="https://placehold.co/600x400", alt="").news__card-img
			