footer.footer
    .footer__main 
        .container 
            .footer__main-inner 
                .footer__logo
                    a(href="/").logo
                          +icon('icon-logo')(width="104" height="104" style="fill: transparent") 
                    img(src="img/logo-footer.png", alt="").img
                    .mobile
                        a(href="#") 
                            +icon('icon-vk-big')(width="52" height="52" style="fill: transparent") 
                        a(href="#")
                            +icon('icon-tg-big')(width="52" height="52" style="fill: transparent") 
                        a(href="#")
                            +icon('icon-ok-big')(width="52" height="52" style="fill: transparent") 
                        a(href="#")
                            +icon('icon-max-big')(width="52" height="52" style="fill: transparent") 
                    .text-14.text-gray
                        span © 2012 – 2026
                        br
                        span При использовании материалов с сайта ссылка на источник обязательна
                nav.footer__nav
                    .block
                        h5.block__title Гражданам
                        .footer__nav-list.text-gray.text-14
                            each item in jsonData.footerNavs.grajdanam
                                a(href=item.link)= item.text
                    .block
                        h5.block__title Услуги
                        .footer__nav-list.text-gray.text-14
                            each item in jsonData.footerNavs.uslugi
                                a(href=item.link)= item.text
                    .block
                        h5.block__title Новости
                        .footer__nav-list.text-gray.text-14
                            each item in jsonData.footerNavs.novosti
                                a(href=item.link)= item.text
                nav.footer__nav-mobile
                    .block
                        button.accordion__button
                            span Гражданам
