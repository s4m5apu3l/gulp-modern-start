extends ../layouts/_default

block variables
    - const title = 'Пользовательское соглашение'
    - const description = ''

block content
    .container
        .base__page-grid.base__page-grid--3 
            div(style="opacity:0;width:0")

            section.inner
                +breadcrumbs([
                    { title: 'Главная', link: '/' },
                    { title: 'Пользовательское соглашение' }
                ])

                section.page-header
                    h1.page-header__title Соглашение о пользовании информационными системами и ресурсами города Набережные Челны
                
                // в дизе не те данные по  тексту поэтому не стал все добавлтяь, там про сайт mos.ru
                .text-page__content
                    ol
                        li
                            h2 Термины и определения
                            ol
                                li Оператор — государственные органы, организации, осуществляющие деятельность по эксплуатации информационных систем и сервисов, по обеспечению доступа к информационным ресурсам города Москвы.
                                
                                li Пароль — уникальная последовательность буквенно-цифровых и специальных символов, формируемая в установленном порядке при регистрации в сервисе, информационной системе города Москвы в целях обеспечения последующего доступа Пользователя к данной информационной системе, сервису.
                                
                                li Пользователь — физическое или юридическое лицо, желающее получить или получившее в установленном порядке доступ к сервисам, информационным ресурсам и информационным системам города Москвы.
                                
                                li Регистрация — первичный ввод информации для доступа к информационной системе (сервису), информационному ресурсу города Москвы.
                                
                                li Сервис — программное приложение, программное и (или) техническое средство, обеспечивающее взаимодействие информационных систем, информационных ресурсов города Москвы или их отдельных элементов (подсистем).

                        li
                            h2 Общие положения
                            ol
                                li Настоящим Соглашением определяются правила организации доступа Пользователя к информационным ресурсам города Москвы, а также при использовании Пользователем функциональных возможностей сервисов и информационных систем города Москвы. Соглашение вступает в силу с момента выражения Пользователем согласия с его условиями в порядке, предусмотренном пунктом 2.3 Соглашения.
                                
                                li Информационные системы, сервисы, информационные ресурсы города Москвы обеспечивают исполнение полномочий органов государственной власти города Москвы, подведомственных им организаций, функционируют в соответствии с законодательством Российской Федерации, нормативными правовыми актами города Москвы, правовыми актами федеральных органов исполнительной власти.
            
            div(style="opacity:0;width:0")