extends ../layouts/_default.pug

block variables
    - const pageTitle = "Вакансии карта";
    - const pageDescription = "";

block content
    .container
        .visible-mobile
            +breadcrumbs([
                { title: 'Главная', link: '/' },
                { title: 'Телефонный справочник', }
            ])
            span.h1 Телефонный справочник
            // добавили кнопку вызова map__other-block тут
            .map__other-button
                button.button.d-flex.text-14.text-medium(style="justify-content:space-between" data-js-map-filter-toggle)
                    span Выберите тип организации
                    +icon('icon-chevron-thin')(width="20" height="20" style="fill: transparent; transform:rotate(-90deg)")

        .map__body
            .map__bg
                img(src="https://placehold.co/600x400", alt="" style="width:100%;height:100%;object-fit:cover")
                // КОСТЫЛЬ: Клик на точку показывает блок снизу (is-active)
                .map__dot(style="position:absolute;right:20%;top:20%" onclick="const block = document.querySelector('[data-js-map-block]'); if(block) { document.querySelectorAll('[data-js-map-block]').forEach(b => b.classList.remove('is-active', 'is-open')); block.classList.add('is-active'); }") 1
                // КОСТЫЛЬ: Активная точка (с зеленой точкой снизу)
                .map__dot.active(style="position:absolute;left:60%;right:20%;top:30%") 10
                .map__dot.map__dot--orange(style="position:absolute;left:80%;right:50%;top:50%") 5
                .map__dot.map__dot--orange.active(style="position:absolute;left:88%;right:50%;top:0%") 5
                .map__dot.map__dot--blue(style="position:absolute;left:88%;right:50%;top:10%")
                    img.icon-img(src="/img/map/clothes.svg", alt="")
                .map__dot.map__dot--black(style="position:absolute;left:88%;right:50%;top:20%")
                    img.icon-img(src="/img/map/gov.svg", alt="")
                .map__dot.map__dot--blue(style="position:absolute;left:88%;right:50%;top:30%")
                    img.icon-img(src="/img/map/rem.svg", alt="")
                .map__dot.map__dot--purple(style="position:absolute;left:88%;right:50%;top:40%")
                    img.icon-img(src="/img/map/bank.svg", alt="")
                .map__dot.map__dot--purple(style="position:absolute;left:88%;right:50%;top:50%")
                    img.icon-img(src="/img/map/car.svg", alt="")
                .map__dot(style="position:absolute;left:88%;right:50%;top:60%")
                    img.icon-img(src="/img/map/gym.svg", alt="")
                .map__dot.map__dot--orange(style="position:absolute;left:88%;right:50%;top:70%")
                    img.icon-img(src="/img/map/food.svg", alt="")
                .map__dot.map__dot--pink(style="position:absolute;left:88%;right:50%;top:80%")
                    img.icon-img(src="/img/map/beauty.svg", alt="")
                .map__dot.map__dot--black(style="position:absolute;left:88%;right:50%;top:90%")
                    img.icon-img(src="/img/map/mail.svg", alt="")

                .map__dot.map__dot--pink(style="position:absolute;left:70%;right:40%;top:0%")
                    img.icon-img(src="/img/map/health.svg", alt="")
                .map__dot.map__dot--green(style="position:absolute;left:70%;right:40%;top:10%")
                    img.icon-img(src="/img/map/tree.svg", alt="")
                .map__dot.map__dot--pink(style="position:absolute;left:70%;right:40%;top:20%")
                    img.icon-img(src="/img/map/pet.svg", alt="")
                .map__dot.map__dot--black(style="position:absolute;left:70%;right:40%;top:30%")
                    img.icon-img(src="/img/map/study.svg", alt="")
                .map__dot.map__dot--blue(style="position:absolute;left:70%;right:40%;top:40%")
                    img.icon-img(src="/img/map/grocery.svg", alt="")
                .map__dot.map__dot--green(style="position:absolute;left:70%;right:40%;top:50%")
                    img.icon-img(src="/img/map/fun.svg", alt="")
                .map__dot.map__dot--blue(style="position:absolute;left:70%;right:40%;top:60%")
                    img.icon-img(src="/img/map/bus.svg", alt="")
                .map__dot.map__dot--purple(style="position:absolute;left:70%;right:40%;top:70%")
                    img.icon-img(src="/img/map/job.svg", alt="")

            .vacancies__map-inner
                .top.d-flex(style="justify-content: space-between;align-items:start")
                    .top__left
                        .news__filters(style="margin:0;padding:4px;gap:4px;flex-direction:row")
                            .input__wrapper.with-icon.white
                                +icon('icon-search')(width="20" height="20" style="fill: transparent")
                                input(type="text" placeholder="Поиск" oninput="this.nextElementSibling.style.display = this.value ? 'flex' : 'none'")
                                button.input__clear(type="button" onclick="this.previousElementSibling.value=''; this.style.display='none'; this.previousElementSibling.focus();" style="display:none")
                                    +icon('icon-close-small')(width="16" height="16" style="fill: transparent")

                        .map__overlay(data-js-map-overlay)

                        .map__flex
                            .map__block.is-active(data-js-map-block)
                                .map__block-header
                                    .map__handle(data-js-map-handle)
                                    .d-flex(style="gap:4px;align-items:start")
                                        button.map__back-btn(data-js-map-back style="display:none")
                                            +icon('icon-chevron-thin')(width="24" height="24" style="fill: transparent;margin-top:3px")
                                        span.map__block-title.text-22-18.text-semi Моторная улица
                                    button.map__block-close(type="button" aria-label="Закрыть" data-js-map-close)
                                        +icon('icon-close')(width="16" height="16" style="fill: transparent")

                                .map__block-content
                                    // Уровень 1
                                    .map__drilldown-level(data-level="1" data-js-drilldown-level)
                                        .vacancies__list
                                            .map__block-link(data-js-drilldown-trigger data-target="buses" data-title="Моторная улица")
                                                .d-flex(style="gap:6px")
                                                    +icon('icon-bus')(width="24" height="24" style="color: #00B955")
                                                    span.text-14.text-medium Автобус
                                                +icon('icon-chevron-thin')(width="24" height="24" style="fill: transparent; color:#1F1F1F4D;transform:rotate(180deg);min-width:24px")
                                            
                                            .map__block-link(data-js-drilldown-trigger data-target="trams" data-title="Трамваи")
                                                .d-flex(style="gap:6px")
                                                    +icon('icon-bus-2')(width="24" height="24" style="fill: #00B955")
                                                    span.text-14.text-medium Трамвай
                                                +icon('icon-chevron-thin')(width="24" height="24" style="fill: transparent; color:#1F1F1F4D;transform:rotate(180deg);min-width:24px")
                                            
                                            .map__block-link(data-js-drilldown-trigger data-target="trolleys" data-title="Троллейбусы")
                                                .d-flex(style="gap:6px")
                                                    +icon('icon-bus-3')(width="24" height="24" style="fill: transparent")
                                                    span.text-14.text-medium Троллейбус
                                                +icon('icon-chevron-thin')(width="24" height="24" style="fill: transparent; color:#1F1F1F4D;transform:rotate(180deg);min-width:24px")
                                    
                                    // Уровень 2
                                    .map__drilldown-level.is-hidden(data-level="2" data-id="buses" data-title="Моторная улица" data-js-drilldown-level)
                                        .map__block-content
                                            a(href="javascript:void(0)" style="gap:6px; align-items: start").link.text-14
                                                +icon('icon-bus')(width="16" height="16" style="color: #00B955")
                                                span Автобусные маршруты
                                            
                                            .map__tabs.mt-12
                                                .map__tabs-header.text-medium.text-14
                                                    button.map__tabs-btn.js-tab-btn.active(data-tab="bus") Автобусы
                                                    button.map__tabs-btn.js-tab-btn(data-tab="shedule") Расписание
                                                
                                                .map__tabs-inner
                                                    .map__tabs-content.js-tab-content.active(data-tab-content="bus")
                                                        .map__block-grid 
                                                            each i in [1,2,3,4,5,6]
                                                                .map__block-link(data-js-drilldown-trigger data-target="bus-detail-3" data-title="Автобус 666" style="justify-content:center") 3
                                                    
                                                    .map__tabs-content.js-tab-content(data-tab-content="shedule")
                                                        .map__block-shedule.vacancies__list

                                                            .d-flex(style="gap:12px")
                                                                .button(style="padding:11px 6px")
                                                                    +icon('icon-bus')(width="24" height="24" style="fill: transparent;color:white")
                                                                .w-full.inner.d-flex.text-14(style="justify-content:space-between;")
                                                                    .d-flex(style="flex-direction:column;align-items:start")
                                                                        span.text-medium 2
                                                                        span.text-gray Улица ДзержинскогоУ лица Дзержинского
                                                                    span.text-medium каждые 7 мин
                                                            .d-flex(style="gap:12px")
                                                                .button(style="padding:11px 6px")
                                                                    +icon('icon-bus')(width="24" height="24" style="fill: transparent")
                                                                .w-full.inner.d-flex.text-14(style="justify-content:space-between;")
                                                                    .d-flex(style="flex-direction:column;align-items:start")
                                                                        span.text-medium 2
                                                                        span.text-gray Улица Дзержинского
                                                                    span.text-medium каждые 50 мин
                                                                    
                                    // Уровен 3
                                    .map__drilldown-level.is-hidden(data-level="3" data-id="bus-detail-3"   data-js-drilldown-level)
                                        .map__block-content
                                            a(href="javascript:void(0)" style="gap:6px; align-items: start").link.text-14
                                                span Сельма — Олег Кошевой
                                            
                                            .map__tabs.mt-12
                                                .map__tabs-header.text-medium.text-14
                                                    button.map__tabs-btn.js-tab-btn.active(data-tab="stops") Остановки
                                                    button.map__tabs-btn.js-tab-btn(data-tab="shedule-1") Расписание
                                                
                                                .map__tabs-inner
                                                    .map__tabs-content.js-tab-content.active(data-tab-content="stops")
                                                        .map__stops
                                                            span.text-14.text-gray 33 остановок
                                                            
                                                            .map__stops-list
                                                                .map__stops-item
                                                                    .map__stops-dot
                                                                    .inner
                                                                        span.text-14 Сельма
                                                                
                                                                .map__stops-item
                                                                    .map__stops-dot
                                                                    .inner
                                                                        span.text-14 Улица Павлика Морозова
                                                                
                                                                .map__stops-item
                                                                    .map__stops-dot
                                                                    .inner
                                                                        span.text-14 Минусинская улица
                                                                
                                                                .map__stops-item
                                                                    .map__stops-dot
                                                                    .inner
                                                                        span.text-14 Беговая улица
                                                                
                                                                .map__stops-item
                                                                    .map__stops-dot
                                                                    .inner
                                                                        span.text-14 Коммкнистическая улица
                                                                
                                                                .map__stops-item
                                                                    .map__stops-dot
                                                                    .inner
                                                                        span.text-14 Автомобильная улица
                                                                
                                                                .map__stops-item.is-current
                                                                    .map__stops-dot
                                                                    .inner
                                                                        span.text-14 Моторная улица
                                                                
                                                                .map__stops-item.is-active
                                                                    .map__stops-dot
                                                                    .inner
                                                                        span.text-14 Батальная улица
                                                                
                                                                .map__stops-item.is-active
                                                                    .map__stops-dot
                                                                    .inner    
                                                                        span.text-14.text-green ещё 23 остановок
                                                                
                                                                .map__stops-item.is-active
                                                                    .map__stops-dot
                                                                    .inner
                                                                        span.text-14 Улица Олега Кошевого
 

                                                    .map__tabs-content.js-tab-content(data-tab-content="shedule-1")
                                                        .map__block-shedule.vacancies__list

                                                            .d-flex(style="gap:12px")
                                                                .button(style="padding:11px 6px")
                                                                    +icon('icon-bus')(width="24" height="24" style="fill: transparent;color:white")
                                                                .w-full.inner.d-flex.text-14(style="justify-content:space-between;")
                                                                    .d-flex(style="flex-direction:column;align-items:start")
                                                                        span.text-medium 666
                                                                        span.text-gray Сельма
                                                                    span.text-medium 7:00   
                                                            .d-flex(style="gap:12px")
                                                                .button(style="padding:11px 6px")
                                                                    +icon('icon-bus')(width="24" height="24" style="fill: transparent")
                                                                .w-full.inner.d-flex.text-14(style="justify-content:space-between;")
                                                                    .d-flex(style="flex-direction:column;align-items:start")
                                                                        span.text-medium 8
                                                                        span.text-gray Улица Дзержинского
                                                                    span.text-medium 20:00
                                    
                                    // Уровень 2: Список трамваев
                                    .map__drilldown-level.is-hidden(data-level="2" data-id="trams" data-title="Трамваи" data-js-drilldown-level)
                                        .vacancies__list
                                            .map__block-link
                                                span.text-14.text-medium Трамвай №3
                                    
                                    // Уровень 2: Список троллейбусов
                                    .map__drilldown-level.is-hidden(data-level="2" data-id="trolleys" data-title="Троллейбусы" data-js-drilldown-level)
                                        .vacancies__list
                                            .map__block-link
                                                span.text-14.text-medium Троллейбус №7
                                    


