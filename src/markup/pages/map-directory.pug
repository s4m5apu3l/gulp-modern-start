extends ../layouts/_default.pug

block variables
    - const pageTitle = "Вакансии карта";
    - const pageDescription = "";

block content
    .container
        .visible-mobile 
            +breadcrumbs([
                { title: 'Главная', link: '/' },
                { title: 'Телефонный справочник', }
            ])
            span.h1 Телефонный справочник
            // добавили кнопку вызова map__other-block тут
            .map__other-button 
                button.button.d-flex.text-14.text-medium(style="justify-content:space-between" data-js-map-filter-toggle) 
                    span Выберите тип организации
                    +icon('icon-chevron-thin')(width="20" height="20" style="fill: transparent; transform:rotate(-90deg)")

        .map__body
            .map__bg
                img(src="https://placehold.co/600x400", alt="" style="width:100%;height:100%;object-fit:cover")
                // КОСТЫЛЬ: Клик на точку показывает блок снизу (is-active)
                .map__dot(style="position:absolute;right:20%;top:20%" onclick="const block = document.querySelector('[data-js-map-block]'); if(block) { document.querySelectorAll('[data-js-map-block]').forEach(b => b.classList.remove('is-active', 'is-open')); block.classList.add('is-active'); }") 1
                // КОСТЫЛЬ: Активная точка (с зеленой точкой снизу)
                .map__dot.active(style="position:absolute;left:60%;right:20%;top:30%") 10
                .map__dot.map__dot--orange(style="position:absolute;left:80%;right:50%;top:50%") 5
                .map__dot.map__dot--orange.active(style="position:absolute;left:88%;right:50%;top:0%") 5
                .map__dot.map__dot--blue(style="position:absolute;left:88%;right:50%;top:10%")
                    img.icon-img(src="/img/map/clothes.svg", alt="")
                .map__dot.map__dot--black(style="position:absolute;left:88%;right:50%;top:20%")
                    img.icon-img(src="/img/map/gov.svg", alt="")
                .map__dot.map__dot--blue(style="position:absolute;left:88%;right:50%;top:30%")
                    img.icon-img(src="/img/map/rem.svg", alt="")
                .map__dot.map__dot--purple(style="position:absolute;left:88%;right:50%;top:40%")
                    img.icon-img(src="/img/map/bank.svg", alt="")
                .map__dot.map__dot--purple(style="position:absolute;left:88%;right:50%;top:50%")
                    img.icon-img(src="/img/map/car.svg", alt="")
                .map__dot(style="position:absolute;left:88%;right:50%;top:60%")
                    img.icon-img(src="/img/map/gym.svg", alt="")
                .map__dot.map__dot--orange(style="position:absolute;left:88%;right:50%;top:70%")
                    img.icon-img(src="/img/map/food.svg", alt="")
                .map__dot.map__dot--pink(style="position:absolute;left:88%;right:50%;top:80%")
                    img.icon-img(src="/img/map/beauty.svg", alt="")
                .map__dot.map__dot--black(style="position:absolute;left:88%;right:50%;top:90%")
                    img.icon-img(src="/img/map/mail.svg", alt="")
                    
                .map__dot.map__dot--pink(style="position:absolute;left:70%;right:40%;top:0%")
                    img.icon-img(src="/img/map/health.svg", alt="")
                .map__dot.map__dot--green(style="position:absolute;left:70%;right:40%;top:10%")
                    img.icon-img(src="/img/map/tree.svg", alt="")
                .map__dot.map__dot--pink(style="position:absolute;left:70%;right:40%;top:20%")
                    img.icon-img(src="/img/map/pet.svg", alt="")
                .map__dot.map__dot--black(style="position:absolute;left:70%;right:40%;top:30%")
                    img.icon-img(src="/img/map/study.svg", alt="")
                .map__dot.map__dot--blue(style="position:absolute;left:70%;right:40%;top:40%")
                    img.icon-img(src="/img/map/grocery.svg", alt="")
                .map__dot.map__dot--green(style="position:absolute;left:70%;right:40%;top:50%")
                    img.icon-img(src="/img/map/fun.svg", alt="")
                .map__dot.map__dot--blue(style="position:absolute;left:70%;right:40%;top:60%")
                    img.icon-img(src="/img/map/bus.svg", alt="")
                .map__dot.map__dot--purple(style="position:absolute;left:70%;right:40%;top:70%")
                    img.icon-img(src="/img/map/job.svg", alt="")
            
            .vacancies__map-inner
                .top.d-flex(style="justify-content: space-between;align-items:start")
                    .top__left
                        .news__filters(style="margin:0;padding:4px;gap:4px;flex-direction:row")
                            .input__wrapper.with-icon.white
                                +icon('icon-search')(width="20" height="20" style="fill: transparent")
                                input(type="text" placeholder="Поиск" oninput="this.nextElementSibling.style.display = this.value ? 'flex' : 'none'")
                                button.input__clear(type="button" onclick="this.previousElementSibling.value=''; this.style.display='none'; this.previousElementSibling.focus();" style="display:none")
                                    +icon('icon-close-small')(width="16" height="16" style="fill: transparent")
                        
                        .map__overlay(data-js-map-overlay)
                        
                        .map__flex

                            // не забываем класс ис-актив чтобы показыввать по дефолту мап__блок скрытый йоо
                            // в справочнике другая логика показа этого блока поэтому добавляем класс .map__block--other
                            .map__other-block(data-js-map-filter-block)
                                // в мобилке опять контент координально меняется диз по кайфу все меняет
                                // причем тут слово организации что за дела почему нет приоритезации то есть единого стиля у блоков которые выходят в мобилке. Везде каждый раз по другому.
                                // я похуй добавил крестик справа не по дизу короче.
                                .map__block-header
                                    span.text-22-18.text-semi Телефонный справочник
                                    button.map__block-close(type="button" aria-label="Закрыть" data-js-map-filter-close)
                                        +icon('icon-close')(width="16" height="16" style="fill: transparent")
                        

                                .map__block-content
                                    .vacancies__list 
                                        .map__block-link(data-js-map-filter-link) 
                                            span.text-14.text-medium Исполнительного комитета
                                            +icon('icon-chevron-thin')(width="24" height="24" style="fill: transparent; color:#1F1F1F4D;transform:rotate(180deg);min-width:24px")
                                            +icon('icon-close-small')(width="16" height="16" style="fill: transparent")
                                        // актив состояние пассив без класса is-active
                                        .map__block-link.is-active(data-js-map-filter-link)
                                            span.text-14.text-medium Учреждение КЦСОН Доверие Учреждение КЦСОН Доверие
                                            +icon('icon-chevron-thin')(width="24" height="24" style="fill: transparent; color:#1F1F1F4D;transform:rotate(180deg);min-width:24px")
                                            +icon('icon-close-small')(width="16" height="16" style="fill: transparent")
                        
                                .map__block-footer
                                    button.button.button--full Выбрать
                                        
                            .map__block.map__block--fit.is-active(data-js-map-block)
                                .map__block-header
                                    .map__handle(data-js-map-handle)
                                    .d-flex(style="gap:4px;align-items:start")
                                        span.text-22-18.text-semi ГАУСО «Комплексный центр социального обслуживания населения «Доверие»
                                    button.map__block-close(type="button" aria-label="Закрыть" data-js-map-close )
                                        +icon('icon-close')(width="16" height="16" style="fill: transparent")

                                .map__block-content
                                    a(href="#" style="gap:6px; align-items: start").link.text-14
                                        +icon('icon-point-green')(width="16" height="16" style="fill: transparent")
                                        span РТ, Наб.Челны пр. М.Джалиля, д.48 ( ГЭС, 8/1)
                                    .contacts-block.mt-12
                                        .contacts-block__title.text-14 
                                            span.text-medium Семёнов Александр Богданович
                                            span.text-gray Менеджер
                                        ul.contacts-block__list
                                            li
                                                a(href="#").link
                                                    +icon('icon-tel')(width="16" height="16" style="fill: transparent")
                                                    span 8 (8552) 30-55-42
                                            li 
                                                a(href="#").link 
                                                    +icon('icon-mail')(width="16" height="16" style="fill: transparent")
                                                    span mail@mail.ru
                                            li 
                                                a(href="#").link 
                                                    +icon('icon-time')(width="16" height="16" style="fill: transparent")
                                                    span 08:00 - 17:00

                            .map__block.map__block--fit.is-active(data-js-map-block)
                                .map__block-header
                                    .map__handle(data-js-map-handle)
                                    .d-flex(style="gap:4px;align-items:start")
                                        span.text-22-18.text-semi ГАУСО «Комплексный центр социального обслуживания населения «Доверие»
                                    button.map__block-close(type="button" aria-label="Закрыть" data-js-map-close )
                                        +icon('icon-close')(width="16" height="16" style="fill: transparent")

                                .map__block-content
                                    a(href="#" style="gap:6px; align-items: start").link.text-14
                                        +icon('icon-point-green')(width="16" height="16" style="fill: transparent")
                                        span РТ, Наб.Челны пр. М.Джалиля, д.48 ( ГЭС, 8/1)
                                    
                                    .map__tabs.mt-12
                                        .map__tabs-header.text-medium.text-14
                                            button.map__tabs-btn.js-tab-btn.active(data-tab="contacts") Основные контакты
                                            button.map__tabs-btn.js-tab-btn(data-tab="details") Детально
                                        
                                        .map__tabs-inner
                                            .map__tabs-content.js-tab-content.active(data-tab-content="contacts")
                                                .contacts-block
                                                    .contacts-block__title.text-22 
                                                        span.text-semi Контакты
                                                    ul.contacts-block__list
                                                        li
                                                            a(href="#").link
                                                                +icon('icon-tel')(width="16" height="16" style="fill: transparent")
                                                                span 8 (8552) 30-55-42
                                                        li 
                                                            a(href="#").link 
                                                                +icon('icon-mail')(width="16" height="16" style="fill: transparent")
                                                                span mail@mail.ru
                                                        li 
                                                            a(href="#").link 
                                                                +icon('icon-time')(width="16" height="16" style="fill: transparent")
                                                                span 08:00 - 17:00
                                            
                                            .map__tabs-content.js-tab-content(data-tab-content="details")
                                                .vacancies__list 
                                                    .map__block-link
                                                        span.text-14.text-medium Отделение 1
                                                        +icon('icon-chevron-thin')(width="24" height="24" style="fill: transparent; color:#1F1F1F4D;transform:rotate(180deg);min-width:24px")
                                                    .map__block-link
                                                        span.text-14.text-medium Отделение 2
                                                        +icon('icon-chevron-thin')(width="24" height="24" style="fill: transparent; color:#1F1F1F4D;transform:rotate(180deg);min-width:24px")