                .main__urls-tab.js-tab-content(data-tab-content="popular")
                    .main__urls-grid
                        a(href="#").main__urls-card
                            span.text-18 Антикризисный штаб
                            .main__urls-card-icon
                                +icon('icon-arrow-green')(width="14" height="14" style="fill: transparent")


                .main__urls-tab.js-tab-content(data-tab-content="questions")
                    .main__urls-grid
                        a(href="#").main__urls-card
                            span.text-18 Правовое просвещение
                            .main__urls-card-icon
                                +icon('icon-arrow-green')(width="14" height="14" style="fill: transparent")
    section.main__section.main__section--gray
        .container
            .main__services
                .swiper-section__header
                    h4.swiper-section__title
                        span Сервисы для горожан
                    // тут в пк есть кнопки для свайпера, но в мобилке все пропадает...
            .main__services-inner
                .main__services-grid
                    a(href="#").main__services-card.main__services-card--white
                        img(src="/img/services/1.svg", alt="")
                        div(style="display:flex; gap:4px; flex-direction:column")
                            span.text-medium.text-18 Виртуальный институт
                            span.text-14.text-gray Информационно-образовательный портал
                    a(href="#").main__services-card.main__services-card--white
                        img(src="/img/services/2.svg", alt="")
                        div(style="display:flex; gap:4px; flex-direction:column")
