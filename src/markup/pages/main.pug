extends ../layouts/_default.pug

block variables
    - const pageTitle = "Главная";
    - const pageDescription = "";
    - const pageLink = "/main";

block content
    section.main__banner.swiper-section
        .container
            .main__banner-inner
                .main__banner-left
                    .footer__logo(style="height:100%")
                        a(href="/").logo
                            +icon('icon-logo')(width="104" height="104" style="fill: transparent")
                        img(src="img/logo-footer.png", alt="").img
                .main__banner-center
                    .swiper.swiper-main-banner
                        .swiper-wrapper
                            each slide in jsonData.mainBanner.slides
                                .swiper-slide
                                    a(href=slide.link).main__banner-slide
                                        if slide.badge
                                            span.main__banner-badge= slide.badge
                                        picture
                                            source(srcset=slide.image.avif type="image/avif")
                                            source(srcset=slide.image.webp type="image/webp")
                                            img(src=slide.image.jpg alt=slide.title loading="lazy")

                .main__banner-right
                    .swiper.swiper-main-banner-content
                        .swiper-wrapper
                            each slide in jsonData.mainBanner.slides
                                .swiper-slide
                                    article.base__card
                                        .base__card-content
                                            h5.base__card-title= slide.title
                                            p.base__card-description= slide.description
                                            time.base__card-date= slide.date && slide.region

                    .main__banner-nav
                        button.swiper-section__nav-btn.main__banner-nav-btn--prev(type="button" aria-label="Предыдущий слайд")
                            +icon('icon-arrow-right')(width="24" height="24" style="fill: transparent")
                        button.swiper-section__nav-btn.main__banner-nav-btn--next(type="button" aria-label="Следующий слайд")
                            +icon('icon-arrow-right')(width="24" height="24" style="fill: transparent")
                    .swiper-pagination.main__banner-pagination

            .main__banner-cards.main__banner-cards--grid-desktop.js-swiper-section.swiper(data-swipes="4" data-swiper-mobile-only="1" data-swipes-mobile="1.15")
                .swiper-wrapper
                    each item in jsonData.regionNews.items
                        .swiper-slide
                            a(href=item.link).base__card-link
                                article.base__card
                                    img(src="https://placehold.co/600x400" alt=item.title loading="lazy").base__card-img
                                    .base__card-content
                                        h5.base__card-title= item.title
                                        p.base__card-description= item.description
                                        time.base__card-date(datetime=item.dateISO)= item.date

    section.main__section.main__section--gray.swiper-section.main__section--region
        .container
            h4.swiper-section__title
                +icon('icon-rss')(width="24" height="24" style="fill: transparent")
                span Новости региона
            .main__news-inner
                .main__news-list
                    each dateGroup in jsonData.mainNews.dates
                        .main__news-date-group
                            .main__news-date-header
                                h3.main__news-date= dateGroup.date
                                span.text-gray.text-12= dateGroup.label

                            .main__news-items
                                each newsItem in dateGroup.items
                                    a(href=newsItem.link).main__news-item
                                        img(src=newsItem.image alt=newsItem.title loading="lazy").main__news-item-img
                                        .main__news-item-content
                                            h4.main__news-item-title= newsItem.title
                                            .main__news-item-meta
                                                time.main__news-item-time= newsItem.time
                                                span.main__news-item-category= newsItem.category

                .news__popular
                    .news__popular-header
                        h3.news__popular-title Популярное
                        +icon('icon-star')(width="20" height="20" style="fill: transparent")

                    .news__popular-list
                        each item, index in jsonData.popularNews
                            a(href=item.link).news__popular-item
                                .news__popular-number= index + 1
                                .news__popular-content
                                    h4.news__popular-item-title= item.title
                                    .news__popular-meta
                                        span.news__popular-date= item.date
                                        span.news__popular-category= item.category
                    .news__popular-list--mobile.swiper.js-swiper-section(data-swipes="10" data-swipes-mobile="1.5")
                        .swiper-wrapper
                            each item, index in jsonData.popularNews
                                .swiper-slide
                                    a(href=item.link).news__popular-item
                                        .news__popular-number= index + 1
                                        .news__popular-content
                                            h4.news__popular-item-title= item.title
                                            .news__popular-meta
                                                span.news__popular-date= item.date
                                                span.news__popular-category= item.category
    .container
        // если не нравится то можете внутри секции добавить
        // тогда внутрь --grey секции будет а по дизу кнопка за пределы выходит.364н4т_ди3
        .show-more-block
            a(href="#").show-more.show-more--green
                span.left
                    span.dot
                    span.text Все новости
                .icon  →

    section.main__section
        .container
            h4.swiper-section__title
                span Полезные ресурсы

            // в целом без мата никак ебаные дизы все максимально усложняют
            // картинки не смог скачать, копиривать фигму и пытаться самому исправлять я больше не буду
            // настрадался в других проектах от этого же диза..................
            //
            .main__res-inner
                .main__res-grid.main__res-grid--top
                    each item in jsonData.usefulResources.top
                        article(class=item.theme ? `main__res-card main__res-card--${item.theme}` : 'main__res-card')
                            img(src=item.image alt=item.title).main__res-card-bg
                            .main__res-card-content
                                h3.main__res-card-title= item.title
                                if item.description
                                    p.main__res-card-description= item.description
                                a(href="#").main__res-card-btn= item.buttonText

                .main__res-grid.main__res-grid--bottom
                    each item in jsonData.usefulResources.bottom
                        article(class=item.theme ? `main__res-card main__res-card--${item.theme}` : 'main__res-card')
                            img(src=item.image alt=item.title).main__res-card-bg
                            .main__res-card-content
                                h3.main__res-card-title= item.title
                                if item.description
                                    p.main__res-card-description= item.description
                                a(href="#").main__res-card-btn= item.buttonText
    section.main__section
        .container
            .swiper-section__header
                h4.swiper-section__title
                    span Полезные ссылки
                .swiper-section__tabs
                    button.swiper-section__tab.js-tab-btn.active(type="button" data-tab="important") Важное
                    button.swiper-section__tab.js-tab-btn(type="button" data-tab="popular") Популярное
                    button.swiper-section__tab.js-tab-btn(type="button" data-tab="questions") Вопросы
                // по дизу сделали как свайпера, слишком много свайпера в одной странице
                // убрать надо их, по кайфу добавили
                div(style="opacity: 0; width: 159px")

            .main__urls-inner
                .main__urls-tab.js-tab-content.active(data-tab-content="important")
                    .main__urls-grid
                        each index in [1,2,3,4,5,6,7]
                            a(href="#").main__urls-card
                                span.text-18 Прокурор разъясняет
                                .main__urls-card-icon
