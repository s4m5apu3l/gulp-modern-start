extends ../layouts/_default

block variables
    - const title = 'Обращение к мэру'
    - const description = ''

block content
    .container
        .admin__page-relative
            .admin__page-body
                +breadcrumbs([
                    { title: 'Главная', link: '/' },
                    { title: 'Электронная приёмная', }
                ])
                section.page-header
                    h1.page-header__title Обращение 4569-87
                aside.admin__aside
                    nav.admin__aside-nav.admin__aside-nav--desktop
                        // активный класс просто text-green
                        a(href="#").link Электронная приёмная
                        a(href="#").link.text-green Поиск обращений
                        a(href="#").link Приём граждан
                        a(href="#").link Личный приём мэра
                        a(href="#").link Информация об обращениях
                        a(href="#").link Нормативно-правовая база
                        a(href="#").link Вопросы и ответы

                    .admin__aside-dropdown(data-dropdown)
                        button.admin__aside-dropdown-btn(data-dropdown-btn)
                            span(data-dropdown-current) Электронная приёмная
                            +icon('icon-chevron-down')(width="16" height="16" style="fill: transparent")

                        nav.admin__aside-dropdown-menu
                            a(href="#").link Электронная приёмная
                            a(href="#").link Поиск обращений
                            a(href="#").link Приём граждан
                            a(href="#").link Личный приём мэра
                            a(href="#").link Информация об обращениях
                            a(href="#").link Нормативно-правовая база
                            a(href="#").link Вопросы и ответы

                .mayor__inner
                    .mayor__inner-detail
                        article.services__list-item.green
                            .d-flex(style="margin-top:16px;flex-wrap:wrap;gap:8px")
                                span.badge.badge--green 4569-87
                                span.badge.badge--white 12.08.2024
                                span.badge.badge--white В работе
                                span.badge.badge--white Другая тема
                            h5.text-22-18.text-semi Нужно ли самозанятым сниматься с налогового учёта в случае призыва по мобилизации?    Нужно ли самозанятым сниматься с налогового учёта в случае призыва по мобилизации?
                        article.services__list-item
                            span.text-22-18.text-semi Ответ:
                            p.text-18 Принять участие во Всероссийской переписи населения можно одним из трех способов: дождаться переписчика у себя дома, в ближайшем стационарном переписном участке или пройти перепись самостоятельно в удобное время на портале госуслуг РФ.
                            time.text-gray.text-14 10.09.2024
                        .footer-block.d-flex.text-medium(style="gap:8px")
                            button.button Вопрос решён
                            button.button.button--gray Нет решения