extends ../layouts/_default.pug

block variables
    - const pageTitle = "Вакансии";
    - const pageDescription = "";
    - const pageLink = "/vacancies";

block content
    .container
        .vacancies__inner
            aside.vacancies__aside
                .vacancies__filter
                    .vacancies__filter-head 
                        button.vacancies__filter-close(type="button")
                            +icon('icon-arrow-left')(width="24" height="24" style="fill: transparent")
                        h3.vacancies__filter-title Фильтры
                        button.vacancies__filter-reset-all(type="button") Сбросить 
                    .vacancies__filter-section.vacancies__filter-mobile-time
                        label.vacancies__filter-label Время публикации
                        
                        .vacancies__filter-list
                            label.vacancies__filter-radio
                                input(type="radio" name="time" checked)
                                span Сначала новые
                                span.vacancies__filter-count 34
                            
                            label.vacancies__filter-radio
                                input(type="radio" name="time")
                                span Сначала ранние
                                span.vacancies__filter-count 879
                            
                            label.vacancies__filter-radio
                                input(type="radio" name="time")
                                span За всё время
                                span.vacancies__filter-count 785
                    
                    .vacancies__filter-section
                        label.vacancies__filter-label Исключить слова
                        input.vacancies__filter-input(type="text" placeholder="Исключить слова, через запятую")
                    
                    .vacancies__filter-section
                        label.vacancies__filter-label График работы
                        
                        .news__filter(data-dropdown)
                            button.news__filter-btn(data-dropdown-btn)
                                span(data-dropdown-current) Выберите из списка
                                +icon('icon-chevron-down')(width="16" height="16" style="fill: transparent")
                            .news__filter-menu
                                button.news__filter-item(data-dropdown-item data-value="full-time")
                                    span Полный день
                                button.news__filter-item(data-dropdown-item data-value="part-time")
                                    span Неполный день
                                button.news__filter-item(data-dropdown-item data-value="flexible")
                                    span Гибкий график
                                button.news__filter-item(data-dropdown-item data-value="shift")
                                    span Сменный график
                    
                    .vacancies__filter-section
                        .vacancies__filter-header
                            label.vacancies__filter-label Уровень дохода
                            button.vacancies__filter-reset(type="button") Сбросить
                        input.vacancies__filter-input(type="number" placeholder="от")
                        
                        label.vacancies__filter-checkbox
                            input(type="checkbox" checked)
                            span Указан доход
                            span.vacancies__filter-count 1209
                    
                    .vacancies__filter-section
                        label.vacancies__filter-label Специализации
                        
                        .vacancies__filter-list
                            label.vacancies__filter-checkbox
                                input(type="checkbox" checked)
                                span Продавец-консультант, продавец-кассир
                                span.vacancies__filter-count 386
                            
                            label.vacancies__filter-checkbox
                                input(type="checkbox")
                                span Менеджер по продажам, менеджер по работе с клиентами
                                span.vacancies__filter-count 45
                            
                            label.vacancies__filter-checkbox
                                input(type="checkbox")
                                span Курьер
                                span.vacancies__filter-count 12
                            
                            label.vacancies__filter-checkbox
                                input(type="checkbox")
                                span Другое
                                span.vacancies__filter-count 679
                            label.vacancies__filter-checkbox
                                input(type="checkbox")
                                span Курьер
                                span.vacancies__filter-count 12
                            
                            label.vacancies__filter-checkbox
                                input(type="checkbox")
                                span Другое
                                span.vacancies__filter-count 679
                    
                    .vacancies__filter-section
                        label.vacancies__filter-label Отрасли компании
                        
                        .vacancies__filter-list
                            label.vacancies__filter-checkbox
                                input(type="checkbox" checked)
                                span Автомобильный бизнес
                                span.vacancies__filter-count 386
                            
                            label.vacancies__filter-checkbox
                                input(type="checkbox")
                                span Розничная торговля
                                span.vacancies__filter-count 45
                            
                            label.vacancies__filter-checkbox
                                input(type="checkbox" checked)
                                span Государственные организации
                                span.vacancies__filter-count 12
                            
                            label.vacancies__filter-checkbox
                                input(type="checkbox" checked)
                                span Строительство, недвижимость, эксплуатация
                                span.vacancies__filter-count 679
                    
                    .vacancies__filter-section
                        label.vacancies__filter-label Формат работы
                        
                        .vacancies__filter-list
                            label.vacancies__filter-checkbox
                                input(type="checkbox")
                                span На месте работодателя
                                span.vacancies__filter-count 386
                            
                            label.vacancies__filter-checkbox
                                input(type="checkbox")
                                span Разъездной
                                span.vacancies__filter-count 45
                            
                            label.vacancies__filter-checkbox
                                input(type="checkbox")
                                span Удалённо
                                span.vacancies__filter-count 12
                            
                            label.vacancies__filter-checkbox
                                input(type="checkbox")
                                span Гибрид
                                span.vacancies__filter-count 149
                    
                    .vacancies__filter-section
                        label.vacancies__filter-label Категория прав
                        
                        .news__filter(data-dropdown)
                            button.news__filter-btn(data-dropdown-btn)
                                span(data-dropdown-current) Выберите из списка
                                +icon('icon-chevron-down')(width="16" height="16" style="fill: transparent")
                            .news__filter-menu
                                button.news__filter-item(data-dropdown-item data-value="a")
                                    span Категория A
                                button.news__filter-item(data-dropdown-item data-value="b")
                                    span Категория B
                                button.news__filter-item(data-dropdown-item data-value="c")
                                    span Категория C
                                button.news__filter-item(data-dropdown-item data-value="d")
                                    span Категория D
                                button.news__filter-item(data-dropdown-item data-value="e")
                                    span Категория E
                    
                    .vacancies__filter-section
                        label.vacancies__filter-label Образование
                        
                        .vacancies__filter-list
                            label.vacancies__filter-radio
                                input(type="radio" name="education")
                                span Не требуется или не указано
                                span.vacancies__filter-count 386
                            
                            label.vacancies__filter-radio
                                input(type="radio" name="education")
                                span Высшее
                                span.vacancies__filter-count 45
                            
                            label.vacancies__filter-radio
                                input(type="radio" name="education")
                                span Среднее профессиональное
                                span.vacancies__filter-count 12
                    
                    .vacancies__filter-section
                        label.vacancies__filter-label Опыт работы
                        
                        .vacancies__filter-list
                            label.vacancies__filter-radio
                                input(type="radio" name="experience" checked)
                                span Не имеет значения
                                span.vacancies__filter-count 386
                            
                            label.vacancies__filter-radio
                                input(type="radio" name="experience")
                                span От 1 года до 3 лет
                                span.vacancies__filter-count 45
                    // надо добавить ключ футер на последний
                    .vacancies__filter-section.vacancies__filter-section--footer
                        button.vacancies__filter-reset-all(type="button") Сбросить всё
                        button.button(type="button") Показать 456 вакансий
                .services__ad
                    h5.title Портал государственной гражданской службы
                    p.descr Единая база вакансий гражданской и муниципальной службы
                    a(href="#").btn Смотреть вакансии →
                    img(src="/img/service-ad.svg", alt="").img
                .news__subscribe
                    h3.news__subscribe-title Не пропускайте важные новости города
                    p.news__subscribe-text Подпишитесь на рассылку и получайте подборку новостей портала на эл. почту

                    form.news__subscribe-form
                        input.news__subscribe-input(type="email" placeholder="Ваша электронная почта" required)

                        label.news__subscribe-checkbox
                            input(type="checkbox" required)
                            .news__subscribe-toggle
                            span Согласен на получение новостной рассылки и обработку персональных данных

                        button.news__subscribe-btn(type="submit") Подписаться
            .vacancies__body
                .vacancies__header
                    div
                        +breadcrumbs([
                            { title: 'Главная', link: '/' },
                            { title: 'Вакансии' }
                        ])

                        section.page-header
                            h1.page-header__title Вакансии
                    .vacancies__tabs.swiper.js-swiper-section(data-swipes="3")
                        .swiper-wrapper 
                            .swiper-slide
                                a(href="vacancies.html").vacancies__tabs-item.is-active
                                    +icon('icon-notes')(width="24" height="24")
                                    span Список
                            .swiper-slide
                                a(href="vacancies-map-1.html").vacancies__tabs-item 
                                    +icon('icon-map')(width="24" height="24")
                                    span На карте
                            .swiper-slide
                                a(href="vacancies-favorites.html").vacancies__tabs-item 
                                    +icon('icon-favorites')(width="24" height="24")
                                    span Избранное
                .vacancies__main 
                    .vacancies__search
                        .news__filters
                            .news__search
                                +icon('icon-search')(width="20" height="20" style="fill: transparent")
                                input(type="text" placeholder="Искать вакансию")
                            
                            button.vacancies__filter-toggle(type="button")
                                +icon('icon-filter')(width="24" height="24" style="fill: transparent")
                            
                            .news__filter-group
                                .news__filter(data-dropdown)
                                    button.news__filter-btn(data-dropdown-btn)
                                        span(data-dropdown-current) Сначала новые
                                        +icon('icon-chevron-down')(width="16" height="16" style="fill: transparent")
                                    .news__filter-menu
                                        button.news__filter-item.is-active(data-dropdown-item data-value="new")
                                            span Сначала новые
                                        button.news__filter-item(data-dropdown-item data-value="old")
                                            span Сначала старые
                                
                                .news__filter(data-dropdown)
                                    button.news__filter-btn(data-dropdown-btn)
                                        span(data-dropdown-current) За все время
                                        +icon('icon-chevron-down')(width="16" height="16" style="fill: transparent")
                                    .news__filter-menu
                                        button.news__filter-item.is-active(data-dropdown-item data-value="all")
                                            span За все время
                                        button.news__filter-item(data-dropdown-item data-value="today")
                                            span За сегодня
                                        button.news__filter-item(data-dropdown-item data-value="week")
                                            span За неделю
                                        button.news__filter-item(data-dropdown-item data-value="month")
                                            span За месяц
                                
                                .news__filter(data-dropdown)
                                    button.news__filter-btn(data-dropdown-btn)
                                        span(data-dropdown-current) Тип новости
                                        +icon('icon-chevron-down')(width="16" height="16" style="fill: transparent")
                                    .news__filter-menu
                                        button.news__filter-item.is-active(data-dropdown-item data-value="all")
                                            span Все типы
                                        button.news__filter-item(data-dropdown-item data-value="important")
                                            span Важные
                                        button.news__filter-item(data-dropdown-item data-value="events")
                                            span События
                                        button.news__filter-item(data-dropdown-item data-value="announcements")
                                            span Объявления 
                    .vacancies__list-wrapper
                        .vacancies__list 
                            +vacancies-card()
                            +vacancies-card()
                            +vacancies-card({activeLike:true})
                        .pagination__wrapper
                            ul.pagination__list
                                li.pagination__list-item.is-active
                                    a(href="#").pagination__list-link 1 
                                li.pagination__list-item 
                                    a(href="#").pagination__list-link 1 
                                li.pagination__list-item 
                                    a(href="#").pagination__list-link 1 
                                li.pagination__list-item 
                                    a(href="#").pagination__list-link ...
                                li.pagination__list-item 
                                    a(href="#").pagination__list-link 250
                                li.pagination__list-item 
                                    a(href="#").button Следующая
