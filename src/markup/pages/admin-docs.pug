extends ../layouts/_default.pug

block variables
    - const pageTitle = "Документы";
    - const pageDescription = "";

block content
    .container
        +breadcrumbs([
            { title: 'Главная', link: '/' },
            { title: 'Структура администарции', link: '/admin-main.html' },
            { title: 'Документы' }
        ])

        section.page-header
            h1.page-header__title Документы
        .base__page
            .news__filters(style="margin:0 0 24px 0")
                .news__search
                    +icon('icon-search')(width="24" height="24" style="fill: transparent")
                    input(type="text" placeholder="Введите название блока документов")

                .news__filter-group
                    .news__filter(data-dropdown)
                        button.news__filter-btn(data-dropdown-btn)
                            span(data-dropdown-current) Сначала новые
                            +icon('icon-chevron-down')(width="16" height="16" style="fill: transparent")
                        .news__filter-menu
                            button.news__filter-item.is-active(data-dropdown-item data-value="new")
                                span Сначала новые
                            button.news__filter-item(data-dropdown-item data-value="old")
                                span Сначала старые

                    .news__filter(data-dropdown)
                        button.news__filter-btn(data-dropdown-btn)
                            span(data-dropdown-current) За все время
                            +icon('icon-chevron-down')(width="16" height="16" style="fill: transparent")
                        .news__filter-menu
                            button.news__filter-item.is-active(data-dropdown-item data-value="all")
                                span За все время
                            button.news__filter-item(data-dropdown-item data-value="today")
                                span За сегодня
                            button.news__filter-item(data-dropdown-item data-value="week")
                                span За неделю
                            button.news__filter-item(data-dropdown-item data-value="month")
                                span За месяц

                    .news__filter(data-dropdown)
                        button.news__filter-btn(data-dropdown-btn)
                            span(data-dropdown-current) Тип новости
                            +icon('icon-chevron-down')(width="16" height="16" style="fill: transparent")
                        .news__filter-menu
                            button.news__filter-item.is-active(data-dropdown-item data-value="all")
                                span Все типы
                            button.news__filter-item(data-dropdown-item data-value="important")
                                span Важные
                            button.news__filter-item(data-dropdown-item data-value="events")
                                span События
                            button.news__filter-item(data-dropdown-item data-value="announcements")
                                span Объявления
            .news__list-wrapper
                .afisha__events-grid.afisha__events-grid--3(style="gap:clamp(0.5rem, -0.5938rem + 3.125vw, 1.75rem);")
                    each i in [1,2,3,4]
                        a(href="#").main__services-card.main__services-card--large
                            .badge
                                +icon('icon-doc')(width="16" height="16" style="fill: transparent")
                                span Документ
                            div(style="display:grid;gap:4px")
                                span.text-18-14.text-medium Об утверждении административного регламента предоставления муниципальной услуги по постановке на учет и перерегистрации нуждающихся в улучшении жилищных условий в системе социальной ипотеки в Республике Татарстан
                                span.text-gray.text-14 Пятница, 27 февраля 2026, 12:32
                .news__pagination.pagination__wrapper
                    ul.pagination__list
                        li.pagination__list-item.is-active
                            a(href="#").pagination__list-link 1
                        li.pagination__list-item
                            a(href="#").pagination__list-link 1
                        li.pagination__list-item
                            a(href="#").pagination__list-link 1
                        li.pagination__list-item
                            a(href="#").pagination__list-link ...
                        li.pagination__list-item
                            a(href="#").pagination__list-link 250
                        li.pagination__list-item
                            a(href="#").button Следующая