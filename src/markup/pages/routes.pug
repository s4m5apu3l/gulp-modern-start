extends ../layouts/_default.pug

block variables
	- const pageTitle = "Направления";
	- const pageDescription = "";
	- const pageLink = "/routes";

block content
	.container
		+breadcrumbs([
			{ title: 'Главная', link: '/' },
			{ title: 'Направления' }
		])

		section.page-header
			h1.page-header__title Направления
		.main__routes-inner
			.main__routes-grid
				each route in jsonData.routes.items
					a(href=route.link).main__routes-card.main__routes-card--gray
						div(style="display:flex;align-items:center;gap:10px")
							img(src=route.icon, alt=route.title)
							span.title= route.title
						span.text-14.text-gray= route.description