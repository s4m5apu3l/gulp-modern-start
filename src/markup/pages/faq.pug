extends ../layouts/_default.pug

block variables
    - const pageTitle = "вопросы ответы";
    - const pageDescription = "";
    - const pageLink = "/faq";

block content
    .container
        .base__page-grid.base__page-grid--3
            .left
                +breadcrumbs([
                    { title: 'Главная', link: '/' },
                    { title: 'Вопрос — ответ' }
                ])

                section.page-header
                    h1.page-header__title Вопрос — ответ
                .services-sidebar
                    span.text-gray.text-12.services-sidebar__label Выберите раздел
                    // для того чтобы ссылка была активной надо добавить вам класс .is-active
                    // пример у первого аккордеона
                    nav.services-nav
                        .services-nav__item
                            a(href="#").services-nav__link.is-active
                                span Популярное

                        .services-nav__item
                            a(href="#").services-nav__link
                                span Образование

                        .services-nav__item
                            a(href="#").services-nav__link
                                span Здоровье
            .inner
                .search-input
                    +icon('icon-search')(width="20" height="20" style="fill: transparent")
                    input(type="text" placeholder="Введите ваш вопрос")

                .services__mobile-back
                    a(href="#").back-btn  ←
                    span.text Тестовый заголовок
                .services__list
                    .faq__item 
                        button.accordion__button.faq__item-btn
                            span Результат предоставления
                            .plus
                                +icon('icon-plus')(width="20" height="20" style="fill: transparent")
                        .accordion__content.faq__item-content.services__accordion-content
                            .services__accordion-content-inner.faq__item-inner
                                h4 Обязательные
                                p Запрос заполняется посредством внесения сведений, указанных в приложении 1 к административному регламенту, в интерактивную форму на Портале.

                                h4 Необязательные
                                p Запрос заполняется посредством внесения сведений, указанных в приложении 1 к административному регламенту, в интерактивную форму на Портале.
                                a(href="#") Образец документа
                                ol
                                    li Пример маркированного списка
                                    li Тут еще
                                    li И будет больше

                                h4 Документ, подтверждающий полномочия представителя заявителя
                                ul
                                    li Запрос (заявление) на предоставление государственной услуги
                                    li Документы, удостоверяющие личность заявителя и членов его семьи
                                    li Документ, удостоверяющий личность представителя заявителя в соответствии с Едиными требованиями, в случае обращения представителя заявителя
                    .faq__item 
                        button.accordion__button.faq__item-btn
                            span Перечень необходимых документов Перечень необходимых документов
                            .plus
                                +icon('icon-plus')(width="20" height="20" style="fill: transparent")
                        .accordion__content.faq__item-content.services__accordion-content
                            .services__accordion-content-inner.faq__item-inner
                                h4 Обязательные
                                p Запрос заполняется посредством внесения сведений, указанных в приложении 1 к административному регламенту, в интерактивную форму на Портале.

            aside.services__ad
                h5.title Портал государственной гражданской службы
                p.descr Единая база вакансий гражданской и муниципальной службы
                a(href="#").btn Смотреть вакансии →
                img(src="/img/service-ad.svg", alt="").img

