extends ../layouts/_default

block variables
    - const title = 'Погода'
    - const description = ''

block content
    .container
        .swiper-section__header.swiper-section__header--with-filter
            .block
                +breadcrumbs([
                    { title: 'Главная', link: '/' },
                    { title: 'Погода' },
                ])
                h1.page-header__title
                    span Погода в Набережных Челлнах

            .admin__user-tabs
                a(href="/weather-1.html").vacancies__tabs-item.is-active
                    span Сегодня
                a(href="/weather-1.html").vacancies__tabs-item.weather__tab--hide-mobile
                    span Завтра
                a(href="/weather-2.html").vacancies__tabs-item.weather__tab--hide-mobile
                    span На 10 дней
                a(href="/weather-3.html").vacancies__tabs-item
                    span На месяц
        .base__page
            .weather__info 
                .weather__info-top
                    .weather__info-block
                        .top.text-18
                            span.text-medium Вторник, 24 марта 2026 
                            span.text-gray  &nbsp;·&nbsp;
                            span.text-gray 15:40
                        .content
                            .content__inner 
                                span.number +10°
                                img(src="/img/weather/sun.svg", alt="")
                                div.text-semi.text-22-18 
                                    span Ясно
                                    p Сегодня осадков не ожидается 
                            p.text-green.text-medium.text-18 Ощущается как +7°

                    .badges 
                        .badges__card 
                            img(src="/img/weather/badge-1.svg", alt="").icon
                            div 
                                span.text-18.text-medium 7,5 м/с, ЮЗ
                                p.text-gray.text-14-12 слабый ветер
                        .badges__card 
                            img(src="/img/weather/badge-2.svg", alt="").icon
                            div 
                                span.text-18.text-medium 86%
                                p.text-gray.text-14-12 влажность высокая
                        .badges__card 
                            img(src="/img/weather/badge-3.svg", alt="").icon
                            div 
                                span.text-18.text-medium 753
                                p.text-gray.text-14-12 давление в норме
                        .badges__card 
                            img(src="/img/weather/badge-4.svg", alt="").icon
                            div 
                                span.text-18.text-medium +7°
                                p.text-gray.text-14-12 вода холодная
                        .badges__card 
                            img(src="/img/weather/badge-5.svg", alt="").icon
                            div 
                                span.text-18.text-medium 2
                                p.text-gray.text-14-12 спокойное магнитное поле
                        .badges__card 
                            img(src="/img/weather/badge-6.svg", alt="").icon
                            div 
                                span.text-18.text-medium 1
                                p.text-gray.text-14-12 УФ-индекс низкий

                .weather__info-dates.swiper.js-swiper-section(data-swipes="auto")
                    .swiper-wrapper 
                        each hour in jsonData.weather.hours
                            .swiper-slide 
                                .weather__hour-card
                                    span.weather__hour-time= hour.time
                                    img(src=`/img/weather/${hour.icon}`, alt="").weather__hour-icon
                                    span.text-18.text-medium= hour.temp
                    .swiper-section__nav.swiper-section__nav--hide
                        button.swiper-section__nav-btn.swiper-section__nav-btn--prev(type="button" aria-label="Предыдущий слайд")
                            +icon('icon-arrow-right')(width="24" height="24" style="fill: transparent")
                        button.swiper-section__nav-btn.swiper-section__nav-btn--next(type="button" aria-label="Следующий слайд")
                            +icon('icon-arrow-right')(width="24" height="24" style="fill: transparent")


            .weather__days.visible-mobile 
                h2.weather__days-title.text-26.text-semi.text-gray На 10 дней
                .weather__days-grid
                    each day in jsonData.weather.days
                        a(href="/weather-4.html").weather__day-card
                            .top
                                span.h1.text-semi(class=day.isWeekend ? 'text-red' : '')= day.dayShort
                                .text-22-18.text-gray.text-semi(class=day.isWeekend ? 'text-red' : '')
                                    if day.dayLabel
                                        .text-green= day.dayLabel
                                    else
                                        span=  day.date
                                        if day.month
                                            span  #{day.month}
                            .weather__day-weather
                                .weather__day-period
                                    img(src=`/img/weather/${day.iconDay}`, alt="").weather__day-icon
                                    span.text-18.text-medium= day.tempDay
                                hr.hr
                                .weather__day-period
                                    img(src=`/img/weather/${day.iconNight}`, alt="").weather__day-icon
                                    span.text-18.text-medium= day.tempNight 