extends ../layouts/_default

block variables
    - const title = 'Структура администарции'
    - const description = ''

block content
    .container
        +breadcrumbs([
            { title: 'Главная', link: '/' },
            { title: 'Структура администарции' }
        ])

        section.page-header
            h1.page-header__title Структура администарции       
        .admin__structure
            .left
                .admin__card-base
                    img(src="https://picsum.photos/800/600", alt="").img
                    .content
                        span.text-26.text-semi Магдеев Наиль Гамбарович
                        span.text-14.text-gray Мэр города
                .admin__card-base.admin__card-base--small
                    img(src="https://picsum.photos/800/600", alt="").img
                    .content
                        span.text-26.text-semi Сагидуллина Ирина Алексеевна
                        span.text-14.text-gray Заместитель Главы муниципального образования
            
            .admin__structure-grid
                .main__urls-grid
                    each index in [1,2,3,4,5]
                        a(href="#").main__urls-card
                            span.text-18.text-medium Прокурор разъясняет
                            .main__urls-card-icon
                                +icon('icon-arrow-green')(width="14" height="14" style="fill: transparent")
        
        section.main__section
            .admin__block
                .swiper-section__header
                    h4.swiper-section__title
                        span Депутатский корпус
                    a(href="#").main__urls-card-icon
                        +icon('icon-arrow-green')(width="21" height="21" style="fill: transparent")         
                .admin__block-grid 
                    each item in jsonData.deputies.items
                        .admin__card-small 
                            img(src="https://picsum.photos/800/600", alt="").img
                            .content 
                                span.text-18.text-medium= item.name
                                p.text-14.text-gray= item.position
                                button.text-14.text-green.js-schedule-btn(
                                    data-phone=item.phone
                                    data-email=item.email
                                    data-address=item.address
                                    data-time=item.time
                                    data-map-coordinates=item.mapCoordinates
                                ) График приёма

        section.main__section
            .admin__block
                .swiper-section__header
                    h4.swiper-section__title
                        span Аппарат Мэра
                    a(href="#").main__urls-card-icon
                        +icon('icon-arrow-green')(width="21" height="21" style="fill: transparent")         
                .admin__block-grid 
                    each item in jsonData.deputies.items
                        .admin__card-small 
                            img(src="https://picsum.photos/800/600", alt="").img
                            .content 
                                span.text-18.text-medium= item.name
                                p.text-14.text-gray= item.position
                                button.text-14.text-green.js-schedule-btn(
                                    data-phone=item.phone
                                    data-email=item.email
                                    data-address=item.address
                                    data-time=item.time
                                    data-map-coordinates=item.mapCoordinates
                                ) График приёма
        
        section.main__section
            .swiper-section__header
                h4.swiper-section__title
                    span  Горячая линия
                .swiper-section__nav.swiper-section__nav--hide
                    button.swiper-section__nav-btn.swiper-section__nav-btn--prev(type="button" aria-label="Предыдущий слайд")
                        +icon('icon-arrow-right')(width="24" height="24" style="fill: transparent")
                    button.swiper-section__nav-btn.swiper-section__nav-btn--next(type="button" aria-label="Следующий слайд")
                        +icon('icon-arrow-right')(width="24" height="24" style="fill: transparent")

            .main__afisha-inner
                .main__afisha-swiper.swiper.js-swiper-section(data-swipes="5")
                    .swiper-wrapper
                        each i in [1,2,3,4,5,6]
                            .swiper-slide
                                .main__urls-card
                                    span.text-14.text-medium Информационно-образовательный портал
                                    a(href="#" style="text-decoration: underline dotted").text-green.text-22.text-medium 8 800 00 00

        section.main__section.main__projects
            .container
                .swiper-section__header
                    h4.swiper-section__title
                        span Проекты города
                    .swiper-section__nav
                        button.swiper-section__nav-btn.swiper-section__nav-btn--prev(type="button" aria-label="Предыдущий слайд")
                            +icon('icon-arrow-right')(width="24" height="24" style="fill: transparent")
                        button.swiper-section__nav-btn.swiper-section__nav-btn--next(type="button" aria-label="Следующий слайд")
                            +icon('icon-arrow-right')(width="24" height="24" style="fill: transparent")

                .main__projects-inner
                    .main__projects-main.js-city-projects-main.swiper
                        .swiper-wrapper
                            each project in jsonData.cityProjects.items
                                .swiper-slide
                                    .main__projects-slide
                                        img(src=project.image alt=project.title loading="lazy").main__projects-slide-img
                                        .main__projects-slide-content
                                            span.main__projects-slide-date= project.date
                                            h3.main__projects-slide-title= project.title
                                            p.main__projects-slide-description= project.description
                        .swiper-pagination.main__projects-pagination

                    .main__projects-thumbs.js-city-projects-thumbs.swiper
                        .swiper-wrapper
                            each project in jsonData.cityProjects.items
                                .swiper-slide
                                    .main__projects-thumb
                                        img(src=project.image alt=project.title loading="lazy").main__projects-thumb-img
                                        span.main__projects-thumb-title= project.title

                    .show-more-block
                        a(href="#").show-more.show-more--green
                            span.left
                                span.dot
                                span.text Все проекты города
                            .icon  →

        section.main__section.afisha__section--gray
            .container
                .swiper-section__header
                    h4.swiper-section__title
                        span Направления
                .main__routes-inner
                    .main__routes-grid
                        each route in jsonData.routes.items
                            a(href=route.link).main__routes-card
                                div(style="display:flex;align-items:center;gap:10px")
                                    img(src=route.icon, alt=route.title)
                                    span.title= route.title
                                span.text-14.text-gray= route.description
                        a(href="#").main__routes-card.main__routes-card--last
                            span.text-14 Перейдите к перечню направлений и разделов портала
                            span.text-22 Все направления →



    // Модалка графика приёма
    .schedule-modal(data-js-schedule-modal)
        .schedule-modal__overlay
        .schedule-modal__content
            button.schedule-modal__close(type="button" aria-label="Закрыть")
                +icon('icon-close')(width="24" height="24" style="fill: transparent")
            
            .schedule-modal__body
                div.content
                    h3.text-22.text-semi График приёма
                    .schedule-modal__info
                        .schedule-modal__info-item
                            +icon('icon-call')(width="14" height="14" style="fill: transparent")
                            a(data-schedule-phone href="tel:")
                        
                        .schedule-modal__info-item
                            +icon('icon-mail')(width="14" height="14" style="fill: transparent")
                            a(data-schedule-email href="mailto:")
                        
                        .schedule-modal__info-item
                            +icon('icon-point')(width="14" height="14" style="fill: transparent")
                            span(data-schedule-address)
                        
                        .schedule-modal__info-item
                            +icon('icon-time')(width="14" height="14" style="fill: transparent")
                            span(data-schedule-time)
                .schedule-modal__map
                    iframe(
                        data-schedule-map-iframe
                        width="100%"
                        height="100%"
                        frameborder="0"
                        allowfullscreen
                        style="position:relative;"
                    )