extends ../layouts/_default.pug

block variables
    - const pageTitle = "Услуги";
    - const pageDescription = "";
    - const pageLink = "/mob-1";

block content
    .container
        +breadcrumbs([
            { title: 'Главная', link: '/' },
            { title: 'Услуги' }
        ])

        section.page-header
            h1.page-header__title Услуги

        section.services
            .services__main
                .services__search
                    .search-input
                        +icon('icon-search')(width="24" height="24" style="fill: transparent")
                        input(type="text" placeholder="Найдите интересующую услугу")
                // надо добавить класс .mobile-sidebar--mobile
                .services-sidebar.services-sidebar--mobile
                    span.text-gray.text-12.services-sidebar__label Выберите раздел
                    nav.services-nav
                        .services-nav__item
                            a(href="mob-2.html").services-nav__link
                                img(src="/img/uslugi/star.svg", alt="").icon
                                span Популярное
                                span.services-nav__count 13

                        .services-nav__item
                            a(href="mob-2.html").services-nav__link
                                img(src="/img/uslugi/2.svg", alt="").icon
                                span Образование
                                span.services-nav__count 122

                        .services-nav__item
                            a(href="#").services-nav__link
                                img(src="/img/uslugi/3.svg", alt="").icon
                                span Здоровье
                                span.services-nav__count 15
