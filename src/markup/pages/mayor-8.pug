extends ../layouts/_default

block variables
    - const title = 'Обращение к мэру'
    - const description = ''

block content
    .container
        .admin__page-relative
            .admin__page-body
                +breadcrumbs([
                    { title: 'Главная', link: '/' },
                    { title: 'Электронная приёмная', }
                ])
                section.page-header
                    h1.page-header__title  Вопросы и ответы
                aside.admin__aside
                    nav.admin__aside-nav.admin__aside-nav--desktop
                        // активный класс просто text-green
                        a(href="#").link Электронная приёмная
                        a(href="#").link Поиск обращений
                        a(href="#").link Приём граждан
                        a(href="#").link Личный приём мэра
                        a(href="#").link Информация об обращениях
                        a(href="#").link Нормативно-правовая база
                        a(href="#").link.text-green Вопросы и ответы

                    .admin__aside-dropdown(data-dropdown)
                        button.admin__aside-dropdown-btn(data-dropdown-btn)
                            span(data-dropdown-current) Электронная приёмная
                            +icon('icon-chevron-down')(width="16" height="16" style="fill: transparent")

                        nav.admin__aside-dropdown-menu
                            a(href="#").link Электронная приёмная
                            a(href="#").link Поиск обращений
                            a(href="#").link Приём граждан
                            a(href="#").link Личный приём мэра
                            a(href="#").link Информация об обращениях
                            a(href="#").link Нормативно-правовая база
                            a(href="#").link Вопросы и ответы

                .mayor__inner
                    .vacancies__search.vacancies__search--one
                        .news__filters
                            .input(style="width:100%")
                                .input__wrapper.with-icon.white
                                    +icon('icon-search')(width="24" height="24" style="fill: transparent")
                                    input(type="text" placeholder="Поиск по вопросам и ответам")

                            .news__filter(data-dropdown)
                                button.news__filter-btn(data-dropdown-btn)
                                    span(data-dropdown-current) Выбрать направление работ
                                    +icon('icon-chevron-down')(width="16" height="16" style="fill: transparent")
                                .news__filter-menu
                                    button.news__filter-item.is-active(data-dropdown-item data-value="new")
                                        span Сначала новые
                                    button.news__filter-item(data-dropdown-item data-value="old")
                                        span Сначала старые

                        .vacancies__list-wrapper
                            .vacancies__list
                                .faq__item
                                    button.accordion__button.faq__item-btn
                                        span Нужно ли самозанятым сниматься с налогового учёта в случае призыва по мобилизации?
                                        .plus
                                            +icon('icon-plus')(width="20" height="20" style="fill: transparent")
                                    .accordion__content.faq__item-content.services__accordion-content
                                        .services__accordion-content-inner.faq__item-inner
                                            p В 2023 году в Исполнительном комитете Казани зарегистрировано обращений граждан.
                                
                                .faq__item
                                    button.accordion__button.faq__item-btn
                                        span Нужно ли самозанятым сниматься с налогового учёта в случае призыва по мобилизации?
                                        .plus
                                            +icon('icon-plus')(width="20" height="20" style="fill: transparent")
                                    .accordion__content.faq__item-content.services__accordion-content
                                        .services__accordion-content-inner.faq__item-inner
                                            p В 2023 году в Исполнительном комитете Казани зарегистрировано обращений граждан.
                                

                                