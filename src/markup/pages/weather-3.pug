extends ../layouts/_default

block variables
    - const title = 'Погода'
    - const description = ''

block content
    .container
        .swiper-section__header.swiper-section__header--with-filter
            .block
                +breadcrumbs([
                    { title: 'Главная', link: '/' },
                    { title: 'Погода' },
                ])
                h1.page-header__title
                    span Погода в Набережных Челлнах

            .admin__user-tabs
                a(href="/weather-1.html").vacancies__tabs-item
                    span Сегодня
                a(href="/weather-1.html").vacancies__tabs-item.weather__tab--hide-mobile
                    span Завтра
                a(href="/weather-2.html").vacancies__tabs-item.weather__tab--hide-mobile
                    span На 10 дней
                a(href="/weather-3.html").vacancies__tabs-item.is-active
                    span На месяц
        .base__page
            .visible-mobile 
                h5.weather__days-title.text-26.text-semi.text-gray На месяц
            .weather__month(data-js-weather-calendar)
                .weather__month-tabs.swiper.js-swiper-section(data-swipes="auto")
                    .swiper-wrapper
                        // Табы генерируются динамически в TypeScript
                        // Активный месяц всегда текущий
                .hidden-mobile
                    .weather__calendar-header
                        span.h1 пн
                        span.h1 вт
                        span.h1 ср
                        span.h1 чт
                        span.h1 пт
                        span.h1.text-red сб
                        span.h1.text-red вс
                    // дни в адаптиве оставил как есть потому что в дизе опять плохо сделан, нелогично. Если что пишите в рокет slava
                    .weather__calendar-days
                        each month, index in jsonData.weather.months
                            .weather__month-content(
                                data-month-index=index
                                class=index === 0 ? 'is-active' : ''
                                data-month-days=month.days
                                data-month-name=month.name
                            )
                                .weather__calendar
                                    .weather__calendar-grid(data-js-calendar-grid)
                                        - var days = month.days
                                        - var weatherData = jsonData.weather.calendarWeather
                                        - for (var day = 1; day <= days; day++)
                                            - var weather = weatherData[(day - 1) % weatherData.length]
                                            a.weather__calendar-cell(
                                                href="/weather-4.html"
                                                data-day=day
                                                data-weather-icon=weather.icon
                                                data-weather-temp-day=weather.tempDay
                                                data-weather-temp-night=weather.tempNight
                                            )
                                                h5.text-22-18.text-gray.weather__calendar-date= day
                                                .weather__calendar-weather
                                                    img.weather__calendar-icon(src=`/img/weather/${weather.icon}` alt="")
                                                    .weather__calendar-temp.text-22-18
                                                        span= weather.tempDay
                                                        span.text-gray= weather.tempNight

                .weather__days.visible-mobile 
                    .weather__days-grid
                        each day in jsonData.weather.days
                            a(href="/weather-4.html").weather__day-card
                                .top
                                    span.h1.text-semi(class=day.isWeekend ? 'text-red' : '')= day.dayShort
                                    .text-22-18.text-gray.text-semi(class=day.isWeekend ? 'text-red' : '')
                                        if day.dayLabel
                                            .text-green= day.dayLabel
                                        else
                                            span=  day.date
                                            if day.month
                                                span  #{day.month}
                                .weather__day-weather
                                    .weather__day-period
                                        img(src=`/img/weather/${day.iconDay}`, alt="").weather__day-icon
                                        span.text-18.text-medium= day.tempDay
                                    hr.hr
                                    .weather__day-period
                                        img(src=`/img/weather/${day.iconNight}`, alt="").weather__day-icon
                                        span.text-18.text-medium= day.tempNight 